<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:cocbrpcg.Views"
        xmlns:viewmodels="using:cocbrpcg.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="cocbrpcg.MainWindow"
        x:DataType="viewmodels:CharacterViewModel"
        Title="BRP (CoC7e) Character Builder">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock>Build a Call of Cthulhu 7e character!</TextBlock>

        <StackPanel Orientation="Horizontal">
            <controls:CharacteristicValueInputControl
                CharacteristicLabel="STR"
                CharacteristicValue="70"
                CharacteristicValueHalf="35"
                CharacteristicValueFifth="14"
                />
        </StackPanel>
    </StackPanel>

</Window>
