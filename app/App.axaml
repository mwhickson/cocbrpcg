<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="cocbrpcg.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/views/CharacteristicValueInputControl.axaml"></StyleInclude>
        <StyleInclude Source="/views/SecondaryAttributeValueInputControl.axaml"></StyleInclude>
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="CharacteristicValueInputBackground">#ffffff</SolidColorBrush>
        <SolidColorBrush x:Key="CharacteristicValueInputForeground">#000000</SolidColorBrush>
    </Application.Resources>
</Application>
